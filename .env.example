APP_NAME=MultiPanel
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_KEY=
APP_TIMEZONE=Europe/Madrid
APP_LOCALE=es

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=multipanel
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE=false

JWT_SECRET=
JWT_TTL=3600
JWT_REFRESH_TTL=604800

MAIL_DRIVER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=MultiPanel

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Sandbox: redirige mensajes a usuarios a TELEGRAM_SANDBOX_CHAT_ID
TELEGRAM_SANDBOX=false
TELEGRAM_SANDBOX_CHAT_ID=
TELEGRAM_SANDBOX_COPY_REAL=false

# Avisos de caducidad: solo envían en esta hora local (también en Configuración → Cron)
EXPIRY_NOTIFICATIONS_ENABLED=true
EXPIRY_NOTIFY_HOUR=9
EXPIRY_NOTIFY_TIMEZONE=Europe/Madrid
EXPIRY_NOTIFY_WINDOW_MINUTES=15
EXPIRY_NOTIFY_ADMIN=true
EXPIRY_DEACTIVATE_USER=true

# Alertas admin (servidor caído + resumen diario): email + WhatsApp CallMeBot opcional
ALERT_EMAIL=alex@masquecero.es
WHATSAPP_ALERTS_ENABLED=false
WHATSAPP_CALLMEBOT_PHONE=
WHATSAPP_CALLMEBOT_APIKEY=
# Docs CallMeBot: https://www.callmebot.com/blog/free-api-whatsapp-messages/
# Preferencias por evento (DB en Configuración → WhatsApp / Alertas admin):
# WhatsApp digest + server-down ON por defecto; alta/renovación OFF.
# Telegram digest ON por defecto.

# Token para URLs HTTP de cron: /cron/run?token=...
CRON_TOKEN=

DISCORD_WEBHOOK_URL=

# Stripe (fallback si no hay claves en Ajustes → Facturación).
# Preferible: guardar sk/pk/whsec de Test y Live en el panel y cambiar el modo allí.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=true

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_ENABLED=false
REDIS_PREFIX=multipanel:

RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60

BACKUP_PATH=storage/backups
BACKUP_RETENTION_DAYS=30

LOG_CHANNEL=daily
LOG_LEVEL=info

# OAuth2 / OIDC SSO
OAUTH_GOOGLE_ENABLED=false
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_ENABLED=false
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_MICROSOFT_ENABLED=false
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=

# Remote backups (optional)
BACKUP_REMOTE_ENABLED=false
BACKUP_REMOTE_DRIVER=webhook
BACKUP_WEBHOOK_URL=
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_PREFIX=multipanel/

APP_INSTALLED=false

# Apply database/migrations/*.sql automatically on each web bootstrap
AUTO_MIGRATE=true

# Bizum & Crypto payments
BIZUM_PHONE=
CRYPTO_WALLET_ADDRESS=
CRYPTO_NETWORK=BTC

# Prometheus metrics (optional token protection)
METRICS_TOKEN=

# WebSocket server port
WEBSOCKET_PORT=8081

# Import servicio → servidor MultiPanel (needles case-insensitive / contains)
# 1 = Server10, 5 = NucBox
IMPORT_SERVICIO_1_SERVERS=server10,server 10
IMPORT_SERVICIO_5_SERVERS=nucbox,nuc box

# Peticiones — BD remota legacy (preferible: Configuración → Peticiones / BD remota)
# Nunca subas la contraseña real a Git; déjala vacía aquí.
PETICIONES_DB_HOST=
PETICIONES_DB_PORT=3306
PETICIONES_DB_DATABASE=
PETICIONES_DB_USERNAME=
PETICIONES_DB_PASSWORD=
PETICIONES_DB_CHARSET=utf8mb4
PETICIONES_TMDB_API_KEY=
PETICIONES_SCRAPER_API_KEY=
